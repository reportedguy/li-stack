 "structures": [
  {
   "id": "heres-opener",
   "severity": "warn",
   "regex": "(?im)^\\s*here'?s (?:what|how|why|the thing)\\b",
   "name": "\"Here's what/how/the thing\" line (blocker when it's line 1, -4.3%)",
   "fix": "Delete the bridge and let the next sentence stand. It was the point anyway."
  },
  {
   "id": "reveal-bridge",
   "severity": "blocker",
   "regex": "(?im)^\\s*(?:the )?(?:result|outcome|answer|lesson|catch|kicker|truth|best part|twist)\\?\\s*",
   "name": "\"The result?\" reveal bridge (-4.8%)",
   "fix": "Answer it inline as a plain sentence with a number."
  },
  {
   "id": "plot-twist",
   "severity": "blocker",
   "regex": "(?im)^\\s*(?:plot twist|spoiler alert|spoiler|the twist)\\s*[:?!]",
   "name": "\"Plot twist:\" bridge",
   "fix": "Delete it. State what happened."
  },
  {
   "id": "stop-start",
   "severity": "blocker",
   "regex": "(?im)^\\s*stop [^.\\n]{2,50}[.,]\\s*start\\b",
   "name": "\"Stop X, start Y\" frame (-6.7%)",
   "fix": "Name the cost of X and the exact first step of Y instead."
  },
  {
   "id": "not-just",
   "severity": "warn",
   "regex": "(?i)\\bit'?s not (?:just |only |about )?[^.!?\\n]{2,60}[,.;]\\s*it'?s\\b",
   "name": "\"It's not X, it's Y\" (counts as your one contrast)",
   "fix": "Keep one per post at most. Say the one thing you mean."
  },
  {
   "id": "isnt-its",
   "severity": "warn",
   "regex": "(?i)\\b(?:\\w+ )?(?:isn'?t|is not|aren'?t) (?:a |an |the |about )?[^.!?\\n]{2,40}[.,;]\\s*(?:it'?s|they'?re|this is)\\b",
   "name": "\"X isn't A. It's B.\" (counts as your one contrast)",
   "fix": "Keep one per post at most."
  },
  {
   "id": "not-but",
   "severity": "warn",
   "regex": "(?i)\\bnot (?:just |only )?\\w[^.!?\\n]{1,40}, but\\b",
   "name": "\"Not X, but Y\"",
   "fix": "Keep one contrast per post."
  },
  {
   "id": "not-only",
   "severity": "warn",
   "regex": "(?i)\\bnot only\\b[^.!?\\n]{2,80}\\bbut also\\b",
   "name": "\"Not only X but also Y\"",
   "fix": "Split into two sentences, or drop the weaker half."
  },
  {
   "id": "sincerity",
   "severity": "blocker",
   "regex": "(?im)^\\s*(?:let me be (?:honest|real|direct|clear)|i'?ll be (?:honest|real|direct)|honestly\\?|real talk|full transparency|not gonna lie|ngl|unpopular opinion|confession(?: time)?|can i be (?:honest|vulnerable)[^.?]*\\??)\\s*[:,.!?]?",
   "name": "Announced candor (\"Let me be honest\", \"Confession:\")",
   "fix": "Delete the announcement. State the dated, uncomfortable fact flat."
  },
  {
   "id": "hedge",
   "severity": "warn",
   "regex": "(?i)\\b(?:i (?:might|may|could) be wrong,? but|in my humble opinion|i think it'?s fair to say)\\b",
   "name": "Inserted hedge",
   "fix": "Delete it unless it's genuinely how you talk."
  },
  {
   "id": "staccato-run",
   "severity": "blocker",
   "regex": "(?m)^(?:\\w+\\. ){2,}\\w+\\.\\s*$",
   "name": "Staccato run (\"Short. Punchy. Done.\")",
   "fix": "Merge into one real sentence."
  },
  {
   "id": "no-no-just",
   "severity": "blocker",
   "regex": "(?i)\\bno \\w+[.,] no \\w+[.,] (?:just|only) \\w+",
   "name": "\"No X. No Y. Just Z.\"",
   "fix": "Merge into one real sentence."
  },
  {
   "id": "all-none",
   "severity": "blocker",
   "regex": "(?i)\\ball (?:of )?the \\w+\\. none of the \\w+",
   "name": "\"All the X. None of the Y.\"",
   "fix": "Rewrite as a plain sentence."
  },
  {
   "id": "socratic",
   "severity": "warn",
   "regex": "(?i)\\b(?:why|how)\\? (?:because|simple|easy)\\b",
   "name": "Pseudo-Socratic \"Why? Because...\"",
   "fix": "Just say the because."
  },
  {
   "id": "triad",
   "severity": "warn",
   "regex": "(?i)\\b\\w+, \\w+,? and \\w+\\b",
   "name": "Rule-of-three triad",
   "fix": "One concrete triple per post is fine. Three adjectives or a second triple isn't."
  },
  {
   "id": "comment-gate",
   "severity": "blocker",
   "regex": "(?i:\\b(?:comment|type|drop|reply))\\s+(?:[\\\"'“][^\\\"'”\\n]{1,24}[\\\"'”]|[A-Z]{2,}\\b)\\s+(?i:(?:below\\s+)?(?:and|to get|for|if)\\b)",
   "name": "Comment-gate (\"comment X to get Y\")",
   "fix": "Put the resource in the first comment and say so."
  },
  {
   "id": "announce",
   "severity": "blocker",
   "regex": "(?im)^\\s*(?:i'?m|i am|we'?re|we are) (?:so |super |very )?(?:excited|thrilled|humbled|delighted|honou?red|happy|proud) to (?:announce|share)",
   "name": "Announcement opener",
   "fix": "Open with what actually happened, in order."
  },
  {
   "id": "bait-closer",
   "severity": "warn",
   "regex": "(?im)(?:agree\\?|thoughts\\?|what do you think\\?|who else\\b[^?\\n]*\\??|am i wrong\\?|tag someone[^.\\n]*|let me know in the comments[^.\\n]*|smash (?:the|that) like[^.\\n]*)\\s*$",
   "name": "Reflex engagement bait",
   "fix": "Ask a question only this post could ask."
  },
  {
   "id": "ai-emoji",
   "severity": "warn",
   "regex": "[\\U0001F680\\U0001F525\\U0001F4A1✨\\U0001F3AF]",
   "name": "Rocket / fire / bulb / sparkle / dart emoji",
   "fix": "One emoji max, and not one of these five."
  },
  {
   "id": "model-self",
   "severity": "blocker",
   "regex": "(?i)\\bas an ai\\b|\\bas a (?:large )?language model\\b|\\bas of my (?:last update|knowledge cutoff)\\b",
   "name": "Model self-reference / cutoff line",
   "fix": "Delete the sentence."
  },
  {
   "id": "forensic",
   "severity": "blocker",
   "regex": "(?i)\\boaicite\\b|\\bcontentReference\\b|\\bturn\\d+search\\d+\\b|\\battached_file\\b|\\bgrok_card\\b|\\[(?:Your Name|Your Company|Insert [^\\]]+|NAME|DATE|TOPIC)\\]",
